    <bib:Article rdf:about="#item_200">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:https://link.springer.com/article/10.1007/s10639-024-12485-6"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Yetisensoy, Okan and Karaduman, Hidir</foaf:surname>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_206"/>
        <dc:title>The Effect of AI-Powered Chatbots in Social Studies Education</dc:title>
        <bib:pages>17035--17069</bib:pages>
    </bib:Article>
    <bib:Journal rdf:about="urn:issn:https://link.springer.com/article/10.1007/s10639-024-12485-6">
        <prism:volume>29</prism:volume>
        <dc:title>Education and Information Technologies</dc:title>
        <dc:identifier>DOI 10.1007/s10639-024-12485-6</dc:identifier>
        <dc:identifier>ISSN https://link.springer.com/article/10.1007/s10639-024-12485-6</dc:identifier>
    </bib:Journal>
    <bib:Memo rdf:about="#item_206">
        <rdf:value>&lt;div data-schema-version=&quot;9&quot;&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;Location: Pages 9-11, &quot;Development of chatbots&quot; section and Table 3&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;Evaluation:&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;&amp;nbsp;The &quot;SosyalciBot&quot; chatbot design transcends basic question-answering functionality. It is built upon constructivist learning theory and human-centric AI principles, incorporating multiple functionalities such as lecturing, Q&amp;amp;A exercises, instant feedback, hint provision, and visual aids. The design also thoughtfully addresses social presence through elements like an avatar and backstory, demonstrating a meticulously considered integration of pedagogical methods into the technological architecture.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;</rdf:value>
    </bib:Memo>
    <bib:Article rdf:about="#item_203">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
           <bib:Journal></bib:Journal>
        </dcterms:isPartOf>
    </bib:Article>
</rdf:RDF>
