        <dc:title>Artificial Intelligence (AI) in Primary History – Take CARE!</dc:title>
        <dc:date>2024</dc:date>
        <dc:identifier>
            <dcterms:URI>
                <rdf:value>https://researchonline.ljmu.ac.uk/id/eprint/25461/</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <bib:pages>44-51</bib:pages>
    </bib:Article>
    <bib:Memo rdf:about="#item_195">
        <rdf:value>&lt;div data-schema-version=&quot;9&quot;&gt;&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;Proposes a Highly Practical CARE Framework with Strong Guidance for Teacher Practice&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;&lt;br&gt;Location: Page 3, &quot;A framework for using AI – CARE&quot; section&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;Evaluation:&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;&amp;nbsp;The article proposes the CARE framework –&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;C&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;ollect,&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;A&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;sk,&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;R&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;eview,&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;E&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;xplore – which provides clear and safe steps for frontline teachers (especially non-specialist or novice teachers) to use AI. This framework emphasizes information gathering, precise questioning, critical review, and exploratory improvement, positioning the teacher as a &quot;guide&quot; for AI rather than a &quot;passive recipient&quot;.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;</rdf:value>
    </bib:Memo>
