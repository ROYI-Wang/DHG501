    </z:Attachment>
    <bib:Article rdf:about="#item_198">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:https://link.springer.com/article/10.1007/s11528-025-01062-4"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Chimbunde, Pfuturai and Moreneg, Boitumelo Benjamin</foaf:surname>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_204"/>
        <link:link rdf:resource="#item_199"/>
        <dc:title>Reconfiguring History Teachers’ Assessment Practices in the Context of ChatGPT: Charting the New Terrain</dc:title>
        <dc:date>2025</dc:date>
        <bib:pages>607--617</bib:pages>
    </bib:Article>
    <bib:Journal rdf:about="urn:issn:https://link.springer.com/article/10.1007/s11528-025-01062-4">
        <prism:volume>69</prism:volume>
        <dc:title>TechTrends</dc:title>
        <dc:identifier>ISSN https://link.springer.com/article/10.1007/s11528-025-01062-4</dc:identifier>
    </bib:Journal>
    <bib:Memo rdf:about="#item_204">
        <rdf:value>&lt;div data-schema-version=&quot;9&quot;&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;Pages 5–6: &quot;Challenges of ChatGPT in Assessing History Students&quot;&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;Evaluation:&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;&amp;nbsp;The article elaborates on four major challenges posed by ChatGPT in history assessment: plagiarism and academic integrity, diminished critical thinking, widening digital divides, and lack of human interaction. It particularly highlights how the discipline's reliance on textual output makes it especially vulnerable to AI-generated content, offering a clear subject-specific analysis.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;Lack of Empirical Support in the Research&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;&lt;br&gt;Page 4: &quot;Methodology&quot; section&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;Evaluation:&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color: rgb(15, 17, 21)&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255)&quot;&gt;&amp;nbsp;This study lacks data from students or frontline teachers, making it more of a conceptual or theoretical exploration that provides foundational ideas for future research.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;</rdf:value>
    </bib:Memo>
    <z:Attachment rdf:about="#item_199">
