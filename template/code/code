import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np

# Set style for better visuals
plt.style.use('default')
sns.set_style("whitegrid")
print("🔍 Global AI Education Rules Visualization Analysis")
print("=" * 60)

# Create comprehensive AI education rules dataset
# Note: These scores are estimated based on policy analysis - adjust based on official documents
ai_education_rules = {
    'Country': ['UK', 'EU', 'USA', 'Australia', 'Singapore', 'France', 'Kazakhstan', 'China', 'Japan', 'South Korea'],
    'Region': ['Europe', 'Europe', 'North America', 'Oceania', 'Asia', 'Europe', 'Asia', 'Asia', 'Asia', 'Asia'],
    'Policy_Type': ['Risk Prevention', 'Ethical Regulation', 'Tech Innovation', 'Data Protection', 'Government Led', 'Application Dev', 'Strict Control', 'Integrated Dev', 'Cautious Approach', 'Innovation Led'],
    'Regulation_Strictness': [4, 5, 2, 4, 3, 3, 5, 4, 4, 3],  # 1-5 points, 5 = most strict
    'Innovation_Support': [4, 2, 5, 3, 4, 4, 2, 4, 3, 5],    # 1-5 points, 5 = most supportive
    'Teacher_Training': [4, 2, 5, 3, 3, 4, 2, 3, 3, 4],     # 1-5 points, 5 = most emphasis
    'Data_Privacy': [4, 5, 3, 5, 4, 4, 4, 4, 5, 4],         # 1-5 points, 5 = most emphasis
    'Implementation_Year': [2023, 2022, 2023, 2023, 2022, 2023, 2023, 2023, 2022, 2023]
}

df = pd.DataFrame(ai_education_rules)
print("📊 Dataset Preview:")
print(df.head(10))

# Create comprehensive visualization dashboard
fig = plt.figure(figsize=(20, 16))

# 1. Policy Type Distribution Pie Chart
plt.subplot(3, 3, 1)
policy_counts = df['Policy_Type'].value_counts()
plt.pie(policy_counts.values, labels=policy_counts.index, autopct='%1.1f%%', startangle=90)
plt.title('Global Distribution of AI Education Policy Types', fontweight='bold', fontsize=12)

# 2. Regional Distribution Bar Chart
plt.subplot(3, 3, 2)
region_counts = df['Region'].value_counts()
plt.bar(region_counts.index, region_counts.values, color=['#ff9999', '#66b3ff', '#99ff99', '#ffcc99'])
plt.title('Number of AI Education Policies by Region', fontweight='bold', fontsize=12)
plt.xticks(rotation=45)

# 3. Multi-dimensional Radar Chart (Selected representative countries)
plt.subplot(3, 3, 3)
categories = ['Regulation', 'Innovation', 'Teacher Training', 'Data Privacy']
selected_countries = ['UK', 'EU', 'USA', 'China']

angles = np.linspace(0, 2*np.pi, len(categories), endpoint=False).tolist()
angles += angles[:1]  # Close the radar chart

for country in selected_countries:
    country_data = df[df['Country'] == country].iloc[0]
    values = [
        country_data['Regulation_Strictness'],
        country_data['Innovation_Support'], 
        country_data['Teacher_Training'],
        country_data['Data_Privacy']
    ]
    values += values[:1]  # Close the radar chart
    
    ax = plt.subplot(3, 3, 3, polar=True)
    ax.plot(angles, values, 'o-', linewidth=2, label=country)
    ax.fill(angles, values, alpha=0.1)
    
ax.set_theta_offset(np.pi / 2)
ax.set_theta_direction(-1)
ax.set_xticks(angles[:-1])
ax.set_xticklabels(categories)
ax.set_ylim(0, 5)
plt.title('Multi-dimensional Comparison of Selected Countries', fontweight='bold', fontsize=12, y=1.08)
plt.legend(loc='upper right', bbox_to_anchor=(1.3, 1.0))

# 4. Regulation vs Innovation Scatter Plot
plt.subplot(3, 3, 4)
scatter = plt.scatter(df['Regulation_Strictness'], df['Innovation_Support'], 
                     c=df['Data_Privacy'], s=df['Teacher_Training']*50, 
                     alpha=0.7, cmap='viridis')

# Add country labels
for i, country in enumerate(df['Country']):
    plt.annotate(country, (df['Regulation_Strictness'][i], df['Innovation_Support'][i]),
                xytext=(5, 5), textcoords='offset points', fontsize=9)

plt.xlabel('Regulation Strictness (1-5 points)')
plt.ylabel('Innovation Support (1-5 points)')
plt.title('Regulation vs Innovation Support\n(Bubble size = Teacher Training emphasis)', fontweight='bold', fontsize=12)
plt.colorbar(scatter, label='Data Privacy Emphasis')

# 5. Heatmap: Country Performance Across Dimensions
plt.subplot(3, 3, 5)
heatmap_data = df[['Regulation_Strictness', 'Innovation_Support', 
                  'Teacher_Training', 'Data_Privacy']]
sns.heatmap(heatmap_data, annot=True, cmap='YlOrRd', 
           yticklabels=df['Country'], cbar_kws={'label': 'Score Level'})
plt.title('AI Education Policy Dimension Scores by Country', fontweight='bold', fontsize=12)
plt.ylabel('Country')

# 6. Regional Average Scores Bar Chart
plt.subplot(3, 3, 6)
region_means = df.groupby('Region')[['Regulation_Strictness', 'Innovation_Support', 
                                   'Teacher_Training', 'Data_Privacy']].mean()
region_means.plot(kind='bar', ax=plt.gca())
plt.title('Average Policy Scores by Region', fontweight='bold', fontsize=12)
plt.xticks(rotation=45)
plt.legend(bbox_to_anchor=(1.05, 1), loc='upper left')

# 7. Policy Implementation Timeline
plt.subplot(3, 3, 7)
year_counts = df['Implementation_Year'].value_counts().sort_index()
plt.plot(year_counts.index, year_counts.values, marker='o', linewidth=2, markersize=8)
plt.xlabel('Implementation Year')
plt.ylabel('Number of Policies')
plt.title('AI Education Policy Implementation Timeline', fontweight='bold', fontsize=12)
plt.grid(True, alpha=0.3)

# 8. Policy Type vs Innovation Relationship
plt.subplot(3, 3, 8)
sns.boxplot(data=df, x='Policy_Type', y='Innovation_Support')
plt.title('Innovation Support by Policy Type', fontweight='bold', fontsize=12)
plt.xticks(rotation=45)

# 9. Data Privacy Emphasis Distribution
plt.subplot(3, 3, 9)
plt.hist(df['Data_Privacy'], bins=5, edgecolor='black', alpha=0.7)
plt.xlabel('Data Privacy Emphasis')
plt.ylabel('Number of Countries')
plt.title('Distribution of Data Privacy Emphasis', fontweight='bold', fontsize=12)

plt.tight_layout()
plt.suptitle('Comprehensive Analysis Dashboard: Global AI Education Rules', fontsize=16, fontweight='bold', y=1.02)
plt.show()

print("\n📈 Key Findings:")
print("• European countries generally emphasize regulation and privacy protection")
print("• North American and Asian countries show stronger innovation support") 
print("• Teacher training is a key focus in countries like the USA")
print("• 2023 was a key year for AI education policy implementations")

print("\n🎯 Usage Tips:")
print("1. Click the save icon on each chart to download images")
print("2. Modify scores in the dataframe to update visualizations")
print("3. For interactive charts, consider using plotly instead of matplotlib")

